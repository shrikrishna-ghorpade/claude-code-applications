{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw test:*)",
      "Bash(./mvnw clean package:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Read(src/**)",
      "Edit(src/**)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Edit(pom.xml)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(target/**)",
      "Bash(rm -rf:*)",
      "WebFetch"
    ],
    "defaultMode": "default"
  },
  "env": {
    "SPRING_PROFILES_ACTIVE": "dev"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-bash.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tests-before-commit.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-java.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Reminder: run ./mvnw test before committing.'"
          }
        ]
      }
    ]
  }
}